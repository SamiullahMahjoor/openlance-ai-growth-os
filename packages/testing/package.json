{
  "name": "@openlance/aios-testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Engineering test tooling: deterministic seams (FixedClock, SequentialId), typed doubles, capturing fixtures, an isolated DI container, an integration harness, and Result matchers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "dependencies": {
    "@openlance/aios-errors": "workspace:*",
    "@openlance/aios-kernel": "workspace:*"
  },
  "peerDependencies": {
    "@openlance/aios-di": "workspace:*",
    "@openlance/aios-events": "workspace:*",
    "@openlance/aios-logging": "workspace:*"
  },
  "devDependencies": {
    "@openlance/aios-di": "workspace:*",
    "@openlance/aios-events": "workspace:*",
    "@openlance/aios-logging": "workspace:*",
    "@openlance/aios-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "substrate",
    "constitution": [],
    "stability": "Low",
    "apiVersion": "1.0.0",
    "generation": 1
  }
}
