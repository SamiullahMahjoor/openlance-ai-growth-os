{
  "name": "@openlance/aios-evolution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI evolution abstraction (Specification authority, ADR-0024 category 1 Pure Domain Model per ADR-0024 §42): the evolution classifications, immutable definitions and invariants, and pure ordering predicates that express the evolution specification. No deployment, migration tool, version-control system, or runtime (ai/evolution/, ADR-0020).",
  "main": "./dist/index.js",
