{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "docs": {
      "dependsOn": ["^build"],
      "outputs": ["docs-api/**"]
    },
    "//#lint": {
      "inputs": [
        "**/*.{ts,cts,mts,js,cjs,mjs}",
        "eslint.config.mjs",
        "tools/eslint-config/index.js"
      ]
    },
    "//#depcruise": {
      "inputs": [
        "packages/**/*.ts",
        "tools/**/*.ts",
        "apps/**/*.ts",
        ".dependency-cruiser.cjs",
        "tsconfig.base.json"
      ]
    }
  }
}
