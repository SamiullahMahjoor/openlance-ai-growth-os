{
  "name": "@openlance/aios-{{kebabCase name}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "{{description}}",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
