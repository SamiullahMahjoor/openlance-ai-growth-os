{
  "name": "@openlance/aios-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI agent abstraction (Specification authority, ADR-0024 category 1 Pure Domain Model): the agent classifications, immutable definitions and invariants, and the pure lifecycle ordering predicate that express the agent specification. No agent runtime, orchestration, or execution (ai/agents/, ADR-0020).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "devDependencies": {
    "@openlance/aios-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "namespace",
    "constitution": [
      "OL-AI-AGENTS-README",
      "OL-AI-AGENTS-AGENTS",
      "OL-AI-AGENTS-AGENT-ARCHITECTURE",
      "OL-AI-AGENTS-AGENT-LIFECYCLE",
      "OL-AI-AGENTS-AGENT-CAPABILITIES",
      "OL-AI-AGENTS-AGENT-PERMISSIONS",
      "OL-AI-AGENTS-AGENT-COORDINATION",
      "OL-AI-AGENTS-AGENT-COMMUNICATION",
      "OL-AI-AGENTS-AGENT-DELEGATION",
      "OL-AI-AGENTS-AGENT-SPECIALIZATION",
      "OL-AI-AGENTS-AGENT-BOUNDARIES",
      "OL-AI-AGENTS-AGENT-VERSIONING"
    ],
