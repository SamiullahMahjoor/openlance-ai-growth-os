{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "AIOS library",
  "extends": "./base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "tests"]
}
