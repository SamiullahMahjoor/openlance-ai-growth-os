    "test": "vitest run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "devDependencies": {
    "@openlance/aios-tsconfig": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "substrate",
    "constitution": {{{jsonArray constitution}}},
    "stability": "{{stability}}",
    "apiVersion": "1.0.0",
    "generation": 1
  }
}
