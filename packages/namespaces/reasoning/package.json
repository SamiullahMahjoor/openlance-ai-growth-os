{
  "name": "@openlance/aios-reasoning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI reasoning abstraction (Specification authority, ADR-0024 category 2 Pure Algorithms): the reasoning classifications and pure deterministic algorithms (the stage-transition relation and the lifecycle/workflow orderings) that express the reasoning specification. No reasoning engine, chain of thought, or runtime (ai/reasoning/, ADR-0020).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "devDependencies": {
    "@openlance/aios-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "namespace",
    "constitution": [
      "OL-AI-REASONING-README",
      "OL-AI-REASONING-REASONING",
      "OL-AI-REASONING-REASONING-LIFECYCLE",
      "OL-AI-REASONING-REASONING-WORKFLOW",
      "OL-AI-REASONING-REASONING-STAGES",
      "OL-AI-REASONING-REASONING-STRATEGIES",
      "OL-AI-REASONING-REASONING-VALIDATION",
      "OL-AI-REASONING-REASONING-CONSISTENCY",
      "OL-AI-REASONING-UNCERTAINTY-HANDLING",
      "OL-AI-REASONING-CONCLUSION-FORMATION",
      "OL-AI-REASONING-REASONING-QUALITY",
      "OL-AI-REASONING-REASONING-BOUNDARIES"
    ],
    "stability": "Experimental",
    "apiVersion": "0.0.0",
    "generation": 1
  }
}
