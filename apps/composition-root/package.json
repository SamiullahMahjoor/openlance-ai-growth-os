{
  "name": "@openlance/aios-composition-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Phase 3 Stage 1 application composition root: bootstraps AIOS by composing the substrate services (CONFIG_SERVICE, LOGGER, EVENT_BUS) into a validated, immutable object graph. A thin application over the frozen @openlance/aios-di mechanism; it defines no container, registry, or validation of its own (ADR-0026).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "dependencies": {
    "@openlance/aios-config": "workspace:*",
    "@openlance/aios-di": "workspace:*",
