{
  "name": "@openlance/aios-operations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI operations abstraction (Specification authority, ADR-0024 category 5 Composition Root): the operational classifications, immutable definitions and invariants, and pure ordering predicates that express the operations specification. No monitoring tool, dashboard, DI wiring, or runtime (ai/operations/, ADR-0020).",
  "main": "./dist/index.js",
