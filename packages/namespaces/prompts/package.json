{
  "name": "@openlance/aios-prompts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI prompt abstraction (Specification authority, ADR-0024 category 1 Pure Domain Model): the prompt classifications, immutable definitions and invariants, and pure ordering predicates that express the prompt specification. No prompt engine, template language, or runtime, and no prompt text (ai/prompts/, ADR-0020).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out docs-api"
  },
  "devDependencies": {
    "@openlance/aios-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "namespace",
    "constitution": [
      "OL-AI-PROMPTS-README",
      "OL-AI-PROMPTS-PROMPTS",
      "OL-AI-PROMPTS-PROMPT-ARCHITECTURE",
      "OL-AI-PROMPTS-PROMPT-LIFECYCLE",
      "OL-AI-PROMPTS-PROMPT-COMPOSITION",
      "OL-AI-PROMPTS-PROMPT-ASSEMBLY",
      "OL-AI-PROMPTS-PROMPT-TEMPLATES",
      "OL-AI-PROMPTS-PROMPT-CONTEXT",
      "OL-AI-PROMPTS-PROMPT-VALIDATION",
      "OL-AI-PROMPTS-PROMPT-INHERITANCE",
      "OL-AI-PROMPTS-PROMPT-BOUNDARIES",
      "OL-AI-PROMPTS-PROMPT-VERSIONING"
    ],
    "stability": "Experimental",
    "apiVersion": "0.0.0",
    "generation": 1
  }
}
