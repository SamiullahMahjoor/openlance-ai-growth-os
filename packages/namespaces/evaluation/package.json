{
  "name": "@openlance/aios-evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Immutable, technology-neutral domain model of the AI evaluation abstraction (Specification authority, ADR-0024 category 1 Pure Domain Model): the evaluation classifications, immutable definitions and invariants, and pure ordering predicates that express the evaluation specification. No metric mechanism, test harness, or runtime (ai/evaluation/, ADR-0020).",
  "main": "./dist/index.js",
