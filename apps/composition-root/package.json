    "@openlance/aios-kernel": "workspace:*",
    "@openlance/aios-logging": "workspace:*"
  },
  "devDependencies": {
    "@openlance/aios-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "aios": {
    "layer": "app",
    "constitution": [],
    "stability": "Experimental",
    "apiVersion": "0.0.0",
    "generation": 1
  }
